# Names only. Never put values in this file. Copy to .env (server) and web/.env.local (browser vars).
BRIGHTDATA_API_KEY=
BRIGHTDATA_PLACES_DATASET_ID=
BRIGHTDATA_ZONE=
APIFY_TOKEN=
MAPBOX_TOKEN=
ANTHROPIC_API_KEY=
CACHE_TTL_SECONDS=86400
CACHE_DIR=.cache/places
PREFETCH_ON_STARTUP=1
OVERPASS_URL=
# Local GTFS folder or .zip. Public feeds, no key. Empty means transit stays not sure.
# SF Muni: https://gtfs.sfmta.com/transitdata/google_transit.zip
# BART: https://www.bart.gov/dev/schedules/google_transit.zip
# Times in the feed are read as America/Los_Angeles. A second feed can go in GTFS_DIR_EXTRA.
GTFS_DIR=
GTFS_DIR_EXTRA=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_ORIGINS=http://localhost:3000
PREWARM_DEMO=
ANTHROPIC_MODEL=
