# Copy to web/.env.local (git-ignored). Names and safe defaults only: never commit values.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Browser map key (a URL-restricted public token). Without it the app draws a simple route picture.
NEXT_PUBLIC_MAPBOX_TOKEN=
# 1 = run on saved sample routes with a visible "Sample data" banner (no backend needed). Leave empty for live.
NEXT_PUBLIC_DEV_FIXTURES=
